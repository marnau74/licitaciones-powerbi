ref table 'Órgano'
ref table Territorio
ref table 'Tipo de contrato'
ref table Procedimiento
ref table Estado
ref table Resultado
ref table CPV
ref table Adjudicatario
ref table 'Top N'
ref table Acceso

ref role Comunidad
